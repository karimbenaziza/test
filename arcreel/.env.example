# Copy to .env and fill in. The full list of options is in upstream's
# https://github.com/ArcReel/ArcReel/blob/main/.env.example

# ---- Deployment (read by docker compose) ----
# Image tag on Docker Hub (arcreel/arcreel). Bump to upgrade, then `docker compose pull && docker compose up -d`.
ARCREEL_VERSION=0.33.0
# Host interface for port 1241. Keep 127.0.0.1 unless something else secures access.
ARCREEL_BIND=127.0.0.1
# Public hostname for the `https` profile. Point its DNS A/AAAA record at the server first.
DOMAIN=
TZ=Europe/Paris

# ---- Authentication ----
AUTH_USERNAME=admin
# Leave empty to auto-generate on first start; ArcReel writes it back to this file.
AUTH_PASSWORD=
# Leave empty to auto-generate (logins then reset on every restart).
AUTH_TOKEN_SECRET=

# ---- Database ----
# Default is SQLite in ./projects/arcreel.db. For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/arcreel

# ---- Misc ----
# LOG_LEVEL=INFO
# CORS_ORIGINS=*
